# Local Postgres — create DB with: createdb splitexpense
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/splitexpense

# Generate with: openssl rand -hex 32
# In production (NODE_ENV=production) the server refuses to start without this.
JWT_SECRET=replace-me-with-openssl-rand-hex-32

PORT=3001

# Exact origin of the frontend. In production set to https://your-domain.
CLIENT_URL=http://localhost:5173

# Use 'production' on your PaaS. Locally leave as 'development'.
NODE_ENV=development
